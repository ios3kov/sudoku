DATABASE_URL=postgresql+asyncpg://sudoku:sudoku@localhost:5432/sudoku
REDIS_URL=redis://localhost:6379/0
PUBLIC_ORIGIN=https://sudoku.example.com
SESSION_COOKIE_NAME=sudoku_session
SESSION_TTL_DAYS=30
SECURE_COOKIES=true

S3_BUCKET=sudoku-assets
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3-internal.example.com
S3_PUBLIC_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_ALLOWED_HOSTS=push.apple.com,fcm.googleapis.com,push.services.mozilla.com

# Observability. Leave endpoint empty for local no-export mode.
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=sudoku-api
OTEL_EXPORTER_OTLP_ENDPOINT=
