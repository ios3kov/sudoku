{
  "name": "@sudoku/ios-shell",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:build:sim": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@sudoku/capacitor-native": "file:plugins/sudoku-native"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "typescript": "5.9.3"
  }
}
