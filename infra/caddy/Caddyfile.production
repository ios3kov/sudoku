{$APP_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://assets.{$APP_DOMAIN} wss://{$APP_DOMAIN}; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
    }

    @api path /v1/*
    reverse_proxy @api api:8000

    reverse_proxy web:3000
}


assets.{$APP_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Cross-Origin-Resource-Policy "same-site"
    }

    reverse_proxy minio:9000
}
