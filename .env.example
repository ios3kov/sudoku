# Local compose only. Use secret management in production.
POSTGRES_PASSWORD=local-sudoku-password
MINIO_ROOT_USER=sudoku-local
MINIO_ROOT_PASSWORD=local-minio-password-change-me

# Optional locally; required for production Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Observability. Leave endpoint empty for local no-export mode.
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=sudoku-api
OTEL_EXPORTER_OTLP_ENDPOINT=
