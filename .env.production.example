APP_DOMAIN=sudoku.example.com
# Use URL-unreserved characters because this value is embedded in DATABASE_URL.
# Recommended: openssl rand -hex 32
POSTGRES_PASSWORD=generate-a-long-random-secret
MINIO_ROOT_USER=replace-for-production
# Recommended: an independent openssl rand -hex 32 value.
MINIO_ROOT_PASSWORD=generate-a-long-random-secret
S3_BUCKET=sudoku-assets
S3_REGION=us-east-1
# MinIO is private inside Docker. Browsers use https://assets.<APP_DOMAIN>.
# Create DNS records for both APP_DOMAIN and assets.APP_DOMAIN.
# This must be a dedicated application user, not MINIO_ROOT_USER.
S3_ACCESS_KEY_ID=replace-with-dedicated-minio-app-user
# Recommended: another independent openssl rand -hex 32 value.
S3_SECRET_ACCESS_KEY=generate-a-long-random-secret
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=sudoku-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Production safety gate. Keep true.
REQUIRE_E2EE_NEW_CONVERSATIONS=true
